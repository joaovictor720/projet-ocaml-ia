digraph DFA {
  rankdir=LR;
  node [shape = circle, style=filled, color=black, fillcolor=white];
  node [shape = doublecircle]; 1;
  node [shape = circle];
  secret_node [style=invis, shape=point];
  secret_node -> 1 [label="start"];
  0 -> 1 [label="1"];
  0 -> 0 [label="0"];
  1 -> 0 [label="1"];
  1 -> 1 [label="0"];
}
